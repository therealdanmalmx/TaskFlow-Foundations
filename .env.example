# Environment variables for docker-compose.prod.yml.
# In the course these are set in the Dokploy UI (Environment tab), not in a
# file on the server. This file only documents what the stack needs.
# Never commit a real .env — the repo's .gitignore already blocks it.

# Postgres password, used by both the database and the app's connection string.
# Generate one:  openssl rand -hex 32
# Deliberately blank: copying this file must not create a known password.
DB_PASSWORD=

# Exact lowercase path printed by CI, including owner and repository name.
IMAGE_REPOSITORY=ghcr.io/<lowercase-owner>/<lowercase-repository>

# Mutable channel used normally; replace with a full commit SHA to roll back
# the application image without changing the Compose file.
IMAGE_TAG=latest

# Apply EF Core migrations on startup. Leave true for this app; flip to false
# once you prefer running migrations as a separate deploy step.
RUN_MIGRATIONS=true

# Signs the JWTs that /auth/login issues. At least 32 characters; the app
# refuses to start with a missing or short secret. Rotating it instantly
# signs everyone out (all outstanding tokens stop verifying) — no other harm.
# Generate one:  openssl rand -hex 32
JWT_SECRET=

# Credentials for the seeded course owner, created once on the first boot
# against an empty database. Other users can register and receive an isolated
# workspace. Changing ADMIN_PASSWORD later does not update the stored hash;
# change the seeded owner's password from the signed-in profile instead.
# Generate a password:  openssl rand -base64 24
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# The Redis cache needs no variable here: it runs on the stack's internal
# network with no password and no durable data. The app treats it as optional
# and keeps serving (slower, no activity feed) if the cache is down.
